<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Optera.Shared.Interface</PackageId>
    <Version>1.1.0</Version>
    <Authors>Optera</Authors>
    <Company>Optera</Company>
    <Description>Optera interfaces.</Description>
    <RepositoryUrl>https://github.com/your-repo-url</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
	
  <Target Name="CopyNugetToLocalFeed" AfterTargets="Pack">
    <PropertyGroup>
        <LocalFeed>..\..\Optera\NuGet</LocalFeed>
    </PropertyGroup>
    <MakeDir Directories="$(LocalFeed)" Condition="!Exists('$(LocalFeed)')" />
    <ItemGroup>
        <NuPkgFiles Include="$(PackageOutputPath)Optera.Shared.Interface.*.nupkg" />
    </ItemGroup>
    <Copy SourceFiles="@(NuPkgFiles)" DestinationFolder="$(LocalFeed)" SkipUnchangedFiles="true" Condition="Exists('%(NuPkgFiles.Identity)')" />
  </Target>

</Project>
